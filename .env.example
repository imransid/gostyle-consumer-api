# Copy to .env and adjust. Docker Compose reads this for ${VAR} substitution,
# and Django reads .env directly for non-Docker local runs.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DB_NAME=gostyle
DB_USER=postgres
DB_PASSWORD=postgres
# For local (non-Docker) runs use 127.0.0.1; Compose overrides this to `db`.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SCHEMA=consumer
