# Copy to .env and adjust. Docker Compose reads this for ${VAR} substitution,
# and Django reads .env directly for non-Docker local runs.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DB_NAME=gostyle
DB_USER=postgres
DB_PASSWORD=postgres
# For local (non-Docker) runs use 127.0.0.1; Compose overrides this to `db`.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SCHEMA=consumer

# Rate-limit / cache store. Local dev and tests override this with an in-memory
# cache, so a running Redis is only needed for production-like runs.
REDIS_URL=redis://127.0.0.1:6379/0

# OTP delivery: "console" logs codes to stdout for local dev. Any other value
# uses the real senders (WhatsApp for phone, email for email).
OTP_SENDER=console
# Required only when OTP_SENDER is not "console".
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Logging. "json" is one object per line, which is what Loki parses; "plain" is
# human-readable and is the default under config.settings.local.
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FORMAT=plain