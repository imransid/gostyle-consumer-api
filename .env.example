# Copy to .env and adjust. Docker Compose reads this for ${VAR} substitution,
# and Django reads .env directly for non-Docker local runs.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
#
# THIS IS THE SAME DATABASE gostyle-platform WRITES TO. Not a copy of it.
# There is nothing to "point at the real data": the platform's own
# DATABASE_URL is this host, this database. Confirm it any time with
#   select system_identifier from pg_control_system();
# from both sides — the numbers match.
#
# SO WHY DOES /discover LOOK LIKE DEMO DATA? Because a salon existing in the
# platform is not enough to make it discoverable. discoverable_salons() starts
# from `storefront` filtered on visibility = 'PUBLIC' AND link_enabled = true,
# and a new storefront defaults to HIDDEN with link_enabled false. A tenant
# with branches, staff and a full service catalogue still returns nothing here
# until someone, in the platform console:
#   1. creates the storefront for the branch  (storefront-edit.create)
#   2. sets it PUBLIC and link_enabled = true
#   3. publishes it                            (storefront.publish -> live_version_id)
# Miss any one of the three and this API correctly shows the salon to nobody.
#
# `manage.py seed_salon` writes one salon with all three already set, which is
# why it is often the only thing /discover returns on a dev database. That is
# the seed working, not a bug — but check `select count(*) from storefront
# where visibility='PUBLIC' and link_enabled` before assuming the API is wrong.
DB_NAME=gostyle
DB_USER=postgres
DB_PASSWORD=postgres
# For local (non-Docker) runs use 127.0.0.1; Compose overrides this to `db`.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SCHEMA=consumer

# Rate-limit / cache store. Local dev and tests override this with an in-memory
# cache, so a running Redis is only needed for production-like runs.
REDIS_URL=redis://127.0.0.1:6379/0

# OTP delivery: "console" logs codes to stdout for local dev. Any other value
# uses the real senders (WhatsApp for phone, email for email).
OTP_SENDER=console
# Required only when OTP_SENDER is not "console".
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Logging. "json" is one object per line, which is what Loki parses; "plain" is
# human-readable and is the default under config.settings.local.
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FORMAT=plain
# gostyle-booking-api. Bookings live in that service and in its own database;
# POST /api/v1/booking forwards there and returns its answer unchanged. The
# default is the Swarm service name, so production needs no entry — set this
# for local development, pointing at wherever booking-api is listening.
# NOTE: no /v1 on the end. That prefix belongs to booking-api and the client
# adds it per path.
BOOKING_API_URL=http://gostyle-booking_api:3851
BOOKING_API_TIMEOUT=10
# Routine (series) bookings, off by default (docs/SERIES_BOOKING_AUDIT.md).
SERIES_BOOKING_V1=false
SERIES_BOOKING_CREATE_TIMEOUT=45







# File uploads (POST /api/v1/upload-files). Same names as gostyle-platform.
# Leave AWS_BUCKET_NAME empty locally to keep files in ./media instead.
AWS_BUCKET_NAME=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=